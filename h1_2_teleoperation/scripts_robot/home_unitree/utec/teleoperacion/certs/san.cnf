[req]
distinguished_name=dn
x509_extensions=v3
prompt=no
[dn]
CN=xr-teleoperate-h1-2
[v3]
subjectAltName=@alt
basicConstraints=CA:FALSE
keyUsage=digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
[alt]
DNS.1=localhost
IP.1=127.0.0.1
IP.2=192.168.0.143
IP.3=192.168.123.164
IP.4=192.168.124.164
