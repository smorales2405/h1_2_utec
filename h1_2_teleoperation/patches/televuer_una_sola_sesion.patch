     ## immersive MODE
+    # ==================== una sola sesion manda ====================
+    # Vuer arranca un handler POR CADA websocket, y cada handler abre su propio
+    # bucle de imagen. Si el navegador del visor tiene varias pestanas con la
+    # pagina -o si reconecta sin cerrar la anterior- se acumulan bucles que
+    # publican JPEG a la vez sobre el mismo dispositivo.
+    #
+    # Medido el 2026-09-10 con SIETE sesiones simultaneas: el visor deja de
+    # leer, la cola de envio del socket llega a 931 kB, y con retrans=0 y
+    # lost=0 -o sea, sin perder un solo paquete-. Al no llegarle nada, el
+    # vigilante de latido del cliente (react-use-websocket, timeout 60 s)
+    # cierra la conexion, reconecta, y suma OTRA sesion. Realimentacion.
+    #
+    # Asi que manda la ultima en llegar y las demas se retiran.
+    def _toma_el_relevo(self, session):
+        anterior = getattr(self, "_sesion_activa", None)
+        testigo = getattr(session, "CURRENT_WS_ID", None) or id(session)
+        self._sesion_activa = testigo
+        if anterior is not None and anterior != testigo:
+            print(f"[televuer] sesion {testigo} toma el relevo; "
+                  f"la anterior ({anterior}) deja de mandar imagen.", flush=True)
+        return testigo
+
+    def _relevado(self, testigo) -> bool:
+        return getattr(self, "_sesion_activa", testigo) != testigo
+
     async def main_image_binocular_zmq(self, session):
+        testigo = self._toma_el_relevo(session)
         if self.use_hand_tracking:
             session.upsert(
                 Hands(
