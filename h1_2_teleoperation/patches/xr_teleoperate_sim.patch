+# Copyright (c) 2025, Unitree Robotics Co., Ltd. All Rights Reserved.
+# License: Apache License, Version 2.0
+"""
+Arregla el congelamiento de la sesion WebXR en Python < 3.11.
+
+Sintoma
+-------
+Con el visor puesto, a los pocos segundos la sesion de Vuer se queda helada:
+el seguimiento de manos deja de actualizarse y la imagen no vuelve. En la
+consola aparece, una sola vez:
+
+    protocol.resume_writing() failed
+      File ".../asyncio/sslproto.py", line 522, in resume_writing
+        self._app_protocol.resume_writing()
+      File ".../aiohttp/base_protocol.py", line 36, in resume_writing
+        assert self._paused
+    AssertionError
+
+Causa
+-----
+`asyncio.sslproto.SSLProtocol` de Python 3.10 reenvia `pause_writing()` y
+`resume_writing()` al protocolo de la aplicacion **sin llevar la cuenta de si
+llego a pausarlo**:
+
+    def resume_writing(self):
+        self._app_protocol.resume_writing()   # a pelo, sin estado
+
+Python 3.11 reescribio sslproto y añadio `_app_writing_paused` justo para
+esto. Como aqui las llamadas llegan desemparejadas y `BaseProtocol` de aiohttp
+las valida con `assert`, salta la excepcion.
+
+Y no es solo ruido en el log. `BaseProtocol` usa `_paused` junto con
+`_drain_waiter`: si el desemparejamiento cae del lado contrario —un `pause`
+cuyo `resume` se pierde porque la excepcion lo aborta— `_paused` se queda en
+`True` para siempre, y cualquier corrutina que espere en `_drain_helper()` no
+despierta nunca. El escritor del websocket se para en seco: la sesion XR se
+congela.
+
+Salta cuando el control de flujo de TCP entra en juego, o sea cuando la red no
+drena el socket tan rapido como se escribe. Con el visor por WiFi es cuestion
+de segundos.
+
+Arreglo
+-------
+Quitar los `assert` y dejar los dos metodos idempotentes, que es lo que hace
+Python 3.11 de fabrica. `resume_writing` sigue resolviendo el `_drain_waiter`,
+asi que nadie se queda esperando.
+
+No hace nada en Python >= 3.11, donde el fallo no existe.
+"""
+
+import sys
+
+
+def apply() -> bool:
+    """Aplica el parche. Devuelve True si se aplico."""
+    if sys.version_info >= (3, 11):
+        return False   # sslproto ya lleva la cuenta del estado
+
+    try:
+        from aiohttp.base_protocol import BaseProtocol
+    except ImportError:
+        return False
+
+    if getattr(BaseProtocol, "_h12_flowcontrol_patched", False):
+        return False
+
+    def pause_writing(self) -> None:
+        # sin `assert not self._paused`: una pausa repetida no cambia nada
+        self._paused = True
+
+    def resume_writing(self) -> None:
+        # sin `assert self._paused`: lo importante es soltar al que espera
+        self._paused = False
+        waiter = self._drain_waiter
+        if waiter is not None:
+            self._drain_waiter = None
+            if not waiter.done():
+                waiter.set_result(None)
+
+    BaseProtocol.pause_writing = pause_writing
+    BaseProtocol.resume_writing = resume_writing
+    BaseProtocol._h12_flowcontrol_patched = True
+    return True
