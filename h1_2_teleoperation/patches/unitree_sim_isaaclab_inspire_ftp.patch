diff --git a/tasks/common_observations/inspire_state.py b/tasks/common_observations/inspire_state.py
index 12fd05e..631b55f 100644
--- a/tasks/common_observations/inspire_state.py
+++ b/tasks/common_observations/inspire_state.py
@@ -105,7 +105,21 @@ def get_robot_inspire_joint_states(
 
     global _obs_cache
     if _obs_cache["device"] != device or _obs_cache["inspire_idx_t"] is None:
-        inspire_joint_indices = [36, 37, 35, 34, 48, 38, 31, 32, 30, 29, 43, 33]
+        # Los indices se resuelven POR NOMBRE, como hace action_provider_dds.py
+        # con inspire_hand_joint_mapping. La lista fija que habia aqui,
+        #     [36, 37, 35, 34, 48, 38, 31, 32, 30, 29, 43, 33]
+        # es la del G1-29dof; el H1-2 tiene otro orden de articulaciones y con
+        # ella el estado de las manos sale barajado (comprobado moviendo un DOF
+        # a la vez: ctrl/l dof3 = L_index aparecia en state/r ranura 1, y
