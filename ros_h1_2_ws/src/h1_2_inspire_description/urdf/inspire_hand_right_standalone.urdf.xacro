<?xml version="1.0" encoding="utf-8"?>
<!-- Inspire RH56DFTP right hand — standalone file for isolated visualization.
     Adds a world link and a fixed base joint so RViz can display the hand alone. -->
<robot name="inspire_hand_right" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- How the coupled phalanges follow the actuated joints: mimic (default, <mimic> tags) or
       software (no <mimic>; scripts/hand_coupling_node.py publishes all 12 joints per hand from
       the curves in config/hand_coupling.yaml). Example: xacro this_file coupling:=software -->
  <xacro:arg name="coupling" default="mimic"/>

  <link name="world"/>

  <joint name="R_hand_base_joint" type="fixed">
    <origin xyz="0 0 0.5" rpy="3.1415926 -1.5707963 1.5"/>
    <parent link="world"/>
    <child link="right_hand_base_link"/>
  </joint>

  <xacro:include filename="$(find h1_2_inspire_description)/urdf/inspire_hand_right.urdf.xacro"/>

</robot>
