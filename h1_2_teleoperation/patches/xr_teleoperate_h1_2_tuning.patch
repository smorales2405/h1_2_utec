+    def _gravity_tauff(self):
+        """Par de gravedad de los 14 motores de brazo, con rampa y tope.
+
+        Se evalua en la posicion MEDIDA, no en la consigna: lo que hay que
+        cancelar es la gravedad que actua ahora. Medido, la diferencia entre
+        una y otra es despreciable (17.3 % contra 17.9 % de sobreimpulso), asi
+        que se elige la que es correcta por principio.
+        """
+        if self._grav is None:
+            return np.zeros(14)
+        try:
+            q = self.get_current_motor_q()[:27]
+            t = self._grav.tau(q)
+        except Exception:
+            return np.zeros(14)
+        tau = np.array([t.get(int(jid), 0.0) for jid in H1_2_JointArmIndex])
+        self._grav_scale = min(1.0, self._grav_scale
+                               + self.control_dt / max(self._grav_ramp_s, 1e-3))
+        return np.clip(tau, -self._grav_max, self._grav_max) * self._grav_scale
