<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>h1_2_vision</name>
  <version>0.1.0</version>
  <description>
    Cámara de cabeza del Unitree H1-2 (Intel RealSense D435i) en ROS 2. La
    cámara está cableada al PC1, al que no tenemos acceso, así que la imagen se
    saca del servicio `videohub` del robot por DDS y se republica como una
    cámara ROS normal: CompressedImage, Image y CameraInfo.
  </description>
  <maintainer email="molortegui@utec.edu.pe">utec</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>unitree_api</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- Para mirar la imagen; no hace falta para publicarla -->
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>image_transport_plugins</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
