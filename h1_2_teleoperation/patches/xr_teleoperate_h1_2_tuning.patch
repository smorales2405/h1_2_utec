     def ctrl_dual_arm_go_home(self):
+        '''Devuelve los brazos a la postura de reposo antes de soltar.
+
+        El original manda los catorce a 0 grados y ahi muere el proceso. En
+        `lowcmd` eso NO baja ganancias: simplemente se deja de publicar y los
+        motores quedan libres. Y soltar en 0 grados es lo peor posible, porque
+        **0 grados de codo es la posicion FLEXIONADA y no es el minimo de
+        gravedad**: sin ganancia el antebrazo cae solo hasta quedar colgando y,
+        con el hombro cerca de 0, ese recorrido lleva LA MANO CONTRA LA PIERNA.
+
+        Medido el 2026-09-09: los codos pasan de 1 grado a 79 y 85 en unos
+        segundos, y las munecas a -20.
+
+        Tiene que hacerse AQUI y no en un script posterior. Comprobado: entre
+        que un proceso suelta y el siguiente toma el control pasan unos 6 s, y
+        para entonces los codos ya han caido 73 y 79 grados. El golpe ocurre en
+        el hueco.
+
+        La secuencia, en tres tramos, y el orden es lo unico que importa:
+
+          1. los shoulder_roll salen a +-`roll_exit`, apartando la mano de la
+             pierna ANTES de que el brazo recorra nada a lo largo del cuerpo;
+          2. los codos se estiran, ya lejos de la pierna;
+          3. todo va a la postura de reposo, con el brazo ya estirado, que ES
+             el minimo de gravedad: al soltar no cae nada (medido: 1.7 grados
+             de deriva, contra 84).
+        '''
+        if self._rest_q is None:
+            return self._ctrl_dual_arm_go_home_original()
+
+        logger_mp.info("[H1_2] volviendo a la postura de reposo…")
+        q = self.get_current_dual_arm_q().copy()
+
+        # 1. apartar los hombros
+        for k, sgn in zip(self._i_roll, self._roll_sign):
+            q[k] = sgn * abs(self._roll_exit)
+        self._ramp_q_target(q, 2.5)
+
+        # 2. estirar los codos, ya lejos de la pierna
+        for k in self._i_elbow:
+            q[k] = self._rest_q[k]
+        self._ramp_q_target(q, 3.0)
+
+        # 3. a reposo, con el brazo estirado = minimo de gravedad
+        self._ramp_q_target(self._rest_q, 2.5)
+        time.sleep(0.5)
+
+        # Bajar ganancias antes de dejar de publicar, para que el traspaso a
+        # "nadie manda" no sea un escalon.
+        for w in np.linspace(1.0, 0.0, 50):
+            for idx, id in enumerate(H1_2_JointArmIndex):
+                self.msg.motor_cmd[id].kp = float(self._kp0[idx] * w)
+                self.msg.motor_cmd[id].kd = float(self._kd0[idx] * w)
+            time.sleep(0.02)
+        logger_mp.info("[H1_2] brazos en reposo, ganancias a 0.")
+
+    def _ctrl_dual_arm_go_home_original(self):
         '''Move both the left and right arms of the robot to their home position by setting the target joint angles (q) and torques (tau) to zero.'''
