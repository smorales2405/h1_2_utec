+        # --- compensacion de gravedad y ganancias por articulacion ---------
+        #
+        # El PD del motor no tiene termino integral: para sostener una postura
+        # contra la gravedad necesita un error permanente tau_g/kp que no se va
+        # nunca. Medido en este robot: 0.97 grados en shoulder_roll con kp=280.
+        # Metiendo el par de gravedad como tau_ff, ese error cae un 85-98 %.
+        #
+        # Los parametros de masa NO son los del URDF, que da 2.57 Nm de error
+        # rms. Se identificaron sobre el robot (h1_2_joint_control, fase F2) y
+        # dan 0.34 Nm. Los dos brazos, ajustados por separado con datos
+        # distintos, coinciden en la masa de la mano al 6 %.
+        #
+        # Si algo falla al cargar, la teleoperacion sigue SIN compensacion en
+        # vez de caerse: es peor, pero funciona.
+        self.use_gravity_ff = True
+        self.gains_set = "tuned_gff"
+        self._grav = None
+        self._grav_scale = 0.0          # rampa de entrada, sin escalon de par
+        self._grav_ramp_s = 1.0
+        self._grav_frac = 0.5           # tope propio, por si el modelo desvaria
+        self._grav_max = np.zeros(14)
+        self._setup_h1_2_joint_control()
