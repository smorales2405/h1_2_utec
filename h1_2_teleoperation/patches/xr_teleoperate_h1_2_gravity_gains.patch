         logger_mp.info("Initialize H1_2_ArmController OK!")
 
+    def _setup_h1_2_joint_control(self):
+        """Carga el modelo de gravedad identificado y las ganancias por
+        articulacion desde el paquete `h1_2_joint_control` de este repositorio.
+
+        `xr_teleoperate` usa cuatro constantes (kp_low/kd_low para hombros y
+        codo, kp_wrist/kd_wrist para munecas) para las catorce articulaciones.
+        El conjunto sintonizado va de kp 40 a 280 y kd 1.8 a 20.25, asi que no
+        cabe en cuatro numeros.
+
+        La ruta del paquete se deduce de la de este fichero; se puede forzar
+        con la variable de entorno H12_JOINT_CONTROL.
+        """
+        import os
+        import sys
+        from pathlib import Path
+        ruta = os.environ.get("H12_JOINT_CONTROL")
+        if not ruta:
+            ruta = str(Path(__file__).resolve().parents[4] / "h1_2_joint_control")
+        if ruta not in sys.path:
+            sys.path.insert(0, ruta)
+        try:
+            from h1_2_joint_control import config as _cfg
+            from h1_2_joint_control.joints import ARM_INDICES as _ARM
+            from h1_2_joint_control.joints import BY_INDEX as _BY
+            from h1_2_joint_control.gravity import GravityModel
+        except Exception as exc:
+            logger_mp.warning("[H1_2] sin h1_2_joint_control (%s): ganancias por "
+                              "defecto y SIN compensacion de gravedad" % exc)
+            self.use_gravity_ff = False
+            return
+
+        try:
+            g = _cfg.load(self.gains_set)
+            for idx, jid in zip(_ARM, H1_2_JointArmIndex):
+                kp, kd = g.for_index(idx)
+                self.msg.motor_cmd[jid].kp = kp
+                self.msg.motor_cmd[jid].kd = kd
+            logger_mp.info("[H1_2] ganancias del conjunto '%s'" % self.gains_set)
+        except Exception as exc:
+            logger_mp.warning("[H1_2] no se pudieron cargar las ganancias '%s' "
+                              "(%s); se dejan las de por defecto"
+                              % (self.gains_set, exc))
+
+        self._grav_max = np.array([self._grav_frac * _BY[i].tau_max for i in _ARM])
+
+        if not self.use_gravity_ff:
+            return
+        try:
+            self._grav = GravityModel(verbose=False)
+            logger_mp.info("[H1_2] compensacion de gravedad activa (%s)"
+                           % ", ".join(sorted(self._grav.fuentes)))
+        except Exception as exc:
+            logger_mp.warning("[H1_2] sin compensacion de gravedad (%s)" % exc)
+            self._grav = None
+            self.use_gravity_ff = False
+
+    def _gravity_tauff(self):
+        """Par de gravedad de los 14 motores de brazo, con rampa y tope.
+
+        Se evalua en la posicion MEDIDA, no en la consigna: lo que hay que
+        cancelar es la gravedad que actua ahora. Medido, la diferencia entre
+        una y otra es despreciable (17.3 % contra 17.9 % de sobreimpulso), asi
+        que se elige la que es correcta por principio.
+        """
+        if self._grav is None:
+            return np.zeros(14)
+        try:
+            q = self.get_current_motor_q()[:27]
+            t = self._grav.tau(q)
+        except Exception:
+            return np.zeros(14)
+        tau = np.array([t.get(int(jid), 0.0) for jid in H1_2_JointArmIndex])
+        self._grav_scale = min(1.0, self._grav_scale
+                               + self.control_dt / max(self._grav_ramp_s, 1e-3))
+        return np.clip(tau, -self._grav_max, self._grav_max) * self._grav_scale
+
     def _subscribe_motor_state(self):
         while True:
