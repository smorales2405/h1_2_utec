<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>h1_2_arm_control</name>
  <version>0.1.0</version>
  <description>
    Control articular de los brazos del Unitree H1-2 por `unitree_hg/LowCmd`.
    Ganancias sintonizadas sobre el robot real, compensación de gravedad con
    parámetros de masa identificados, y protección de autocolisión.
  </description>
  <maintainer email="molortegui@utec.edu.pe">utec</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>unitree_hg</exec_depend>
  <exec_depend>unitree_api</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
