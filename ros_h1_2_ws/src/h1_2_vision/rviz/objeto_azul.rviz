# Vista de la cámara de cabeza y de la prueba del objeto azul.
#
#   rviz2 -d $(ros2 pkg prefix h1_2_vision)/share/h1_2_vision/rviz/objeto_azul.rviz
#
# El marco fijo es el óptico de la cámara, que publica el propio `head_camera`,
# así que esto funciona SIN robot_state_publisher. Si además se lanza el URDF,
# basta cambiar «Fixed Frame» a `pelvis` para ver la esfera colocada respecto
# del robot.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Camara1
        - /Deteccion1
        - /Objeto azul1
      Splitter Ratio: 0.5
    Tree Height: 620
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Rejilla
      Enabled: true
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.5
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camara
      Enabled: true
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /head_camera/image_raw/compressed
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Deteccion
      Enabled: true
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /objeto_azul/imagen/compressed
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Objeto azul
      Enabled: true
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /objeto_azul/marcador
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_color_optical_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.0
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Pitch: 0.2
      Yaw: 3.6
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1720
  X: 60
  Y: 30
  Camara:
    collapsed: false
  Deteccion:
    collapsed: false
