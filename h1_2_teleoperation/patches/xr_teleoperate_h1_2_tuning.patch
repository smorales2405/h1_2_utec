+    def _goto_and_wait(self, q14, tol=0.05, timeout=8.0):
+        """Manda una postura y espera a llegar. El limite de velocidad lo pone
+        el hilo publicador, asi que aqui solo se fija el destino."""
+        with self.ctrl_lock:
+            self.q_target = np.asarray(q14, dtype=float).copy()
+        t0 = time.time()
+        while time.time() - t0 < timeout:
+            if np.all(np.abs(self.get_current_dual_arm_q() - q14) < tol):
+                return True
+            time.sleep(0.02)
+        return False
