+    def _ramp_q_target(self, q_dest, seconds):
+        """Lleva la consigna de donde este a `q_dest` en `seconds`, bloqueando.
+
+        Coseno alzado: velocidad nula al principio y al final, sin tirones. Es
+        la forma correcta de ir despacio, porque el par sigue entero —al
+        contrario que bajar `arm_velocity_limit`, que lo recorta—.
+        """
+        q_ini = np.asarray(self.q_target, dtype=float).copy()
+        q_dest = np.asarray(q_dest, dtype=float)
+        if seconds <= 0.0:
+            with self.ctrl_lock:
+                self.q_target = q_dest.copy()
+            return
+        t0 = time.time()
+        while True:
+            a = min((time.time() - t0) / seconds, 1.0)
+            s = 0.5 - 0.5 * np.cos(np.pi * a)
+            with self.ctrl_lock:
+                self.q_target = q_ini + s * (q_dest - q_ini)
+            if a >= 1.0:
+                return
+            time.sleep(self.control_dt)
+
+    def _arranque_suave(self):
+        """Hilo de arranque: de donde este el brazo a 0 grados, despacio.
+
+        El original pone `q_target = zeros(14)` antes de arrancar el hilo
+        publicador, o sea que el robot sale hacia 0 grados 91 lineas antes del
+        "Press [r] to start". Con los codos estirados son 80 grados.
+        """
+        try:
+            self._ramp_q_target(np.zeros(14), self._startup_ramp_s)
+        except Exception as exc:
+            logger_mp.warning("[H1_2] arranque suave interrumpido (%s)" % exc)
