# Claves y certificados: se generan localmente con scripts/02_gen_certs.sh
*.pem
*.key
*.crt
*.csr
*.srl

# Repositorios upstream, se clonan aparte
h1_2_teleoperation/xr_teleoperate/
h1_2_teleoperation/unitree_sdk2_python/
h1_2_teleoperation/inspire_hand_ws/
h1_2_teleoperation/unitree_sim_isaaclab/
h1_2_teleoperation/cyclonedds/

# Instalación del PC2 (bundle offline de ruedas)
h1_2_teleoperation/pc2_offline/

# Artefactos de trabajo
h1_2_teleoperation/logs/
h1_2_teleoperation/camera_test/
__pycache__/
*.pyc
.venv/

# Ensayos de h1_2_joint_control: las trazas crudas se quedan en local (6-7 MB
# por sesión), pero el índice de métricas SÍ se versiona: es el registro que
# citan docs/06_RESULTADOS.md y la bitácora.
h1_2_joint_control/logs/*.csv
!h1_2_joint_control/logs/index.csv
h1_2_joint_control/logs/*.png

# Artefactos de compilación del workspace ROS
ros_h1_2_ws/build/
ros_h1_2_ws/install/
ros_h1_2_ws/log/
